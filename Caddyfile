sensecare.jacob-j.com {
	# Room devices and the SvelteKit server reach the API here, under the same host.
	handle /api/* {
		reverse_proxy api:8080
	}

	# API documentation, on for the demonstration. Would be off in real operation.
	handle /swagger-ui* {
		reverse_proxy api:8080
	}

	handle /api-docs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header Strict-Transport-Security "max-age=31536000"
}
