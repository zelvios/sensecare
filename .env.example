POSTGRES_DB=sensecare
POSTGRES_USER=sensecare
POSTGRES_PASSWORD=change-me

API_PORT=8080
RUST_LOG=info,sqlx=warn

WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# development (default) or production. Production requires WEB_ORIGIN.
APP_ENV=development

# Creates user 'admin' on first start if the users table is empty. Remove after first login.
BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
